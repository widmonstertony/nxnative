+// This frozen Ocarina engine advances parts of gameplay on the presented
+// frame cadence. On M2, inheriting uncapped can present at 120 Hz.
+static BOOL TTRequiresNativePacing(NSString *titleID){
+    return [titleID.lowercaseString isEqualToString:@"0400486024dec000"];
+}
+static void TTApplyNativePacing(NSString *titleID){
+    if(!TTRequiresNativePacing(titleID))return;
+    setenv("DM_FRAME_LIMIT","game",1);
+    setenv("DM_PRESENT_INTERVAL","game",1);
+    setenv("DM_PRESENT_HZ","60",1);
+    NSLog(@"TonTon native pacing %@: 60 Hz, game interval",titleID);
+}
